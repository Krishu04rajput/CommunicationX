
/* Server icon and banner styles */
.server-icon {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: #007bff;
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    font-size: 18px;
    margin-right: 12px;
    flex-shrink: 0;
}

.server-icon-img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
}

.server-logo-small {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #007bff;
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    font-size: 14px;
    object-fit: cover;
}

.server-banner {
    width: 100%;
    margin-bottom: 1rem;
}

.server-banner-img {
    width: 100%;
    height: 120px;
    object-fit: cover;
    border-radius: 8px;
}

/* Enhanced Message Input Styles */
.message-input-container {
    background: #f8f9fa;
    border-top: 1px solid #dee2e6;
    padding: 16px;
    position: sticky;
    bottom: 0;
    z-index: 100;
}

.typing-indicator {
    background: rgba(0, 123, 255, 0.1);
    padding: 8px 12px;
    border-radius: 16px;
    margin-bottom: 8px;
    font-size: 14px;
    color: #007bff;
    display: flex;
    align-items: center;
}

.typing-text::after {
    content: '...';
    animation: typingDots 1.5s infinite;
}

@keyframes typingDots {
    0%, 20% { opacity: 0; }
    50% { opacity: 1; }
    100% { opacity: 0; }
}

.reply-preview {
    background: #e9ecef;
    border-left: 4px solid #007bff;
    padding: 8px 12px;
    margin-bottom: 8px;
    border-radius: 4px;
}

.reply-header {
    display: flex;
    justify-content: between;
    align-items: center;
    font-size: 12px;
    color: #6c757d;
    margin-bottom: 4px;
}

.reply-user {
    font-weight: bold;
    color: #007bff;
}

.reply-close {
    background: none;
    border: none;
    font-size: 18px;
    color: #6c757d;
    cursor: pointer;
    margin-left: auto;
}

.input-group.enhanced {
    display: flex;
    align-items: flex-end;
    gap: 8px;
    background: white;
    border: 2px solid #dee2e6;
    border-radius: 24px;
    padding: 8px 12px;
    transition: border-color 0.2s;
}

.input-group.enhanced:focus-within {
    border-color: #007bff;
    box-shadow: 0 0 0 0.25rem rgba(0, 123, 255, 0.25);
}

.input-action-btn {
    background: none;
    border: none;
    padding: 8px;
    border-radius: 50%;
    cursor: pointer;
    color: #6c757d;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
}

.input-action-btn:hover {
    background: #f8f9fa;
    color: #007bff;
}

.message-input-wrapper {
    flex: 1;
    position: relative;
}

.message-input.enhanced {
    width: 100%;
    border: none;
    outline: none;
    resize: none;
    font-size: 14px;
    line-height: 1.5;
    max-height: 120px;
    background: transparent;
}

.input-counter {
    position: absolute;
    bottom: -20px;
    right: 0;
    font-size: 11px;
    color: #6c757d;
}

.send-btn {
    background: #007bff;
    border: none;
    border-radius: 50%;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    cursor: pointer;
    transition: all 0.2s;
}

.send-btn:disabled {
    background: #dee2e6;
    cursor: not-allowed;
}

.send-btn:not(:disabled):hover {
    background: #0056b3;
    transform: scale(1.05);
}

.file-preview-area {
    margin-top: 12px;
    padding: 12px;
    background: #f8f9fa;
    border-radius: 8px;
    border: 1px dashed #dee2e6;
}

.voice-recording {
    margin-top: 12px;
    padding: 12px;
    background: #fff3cd;
    border-radius: 8px;
    border: 1px solid #ffeaa7;
}

.recording-indicator {
    display: flex;
    align-items: center;
    gap: 8px;
}

.recording-dot {
    width: 12px;
    height: 12px;
    background: #dc3545;
    border-radius: 50%;
    animation: pulse 1s infinite;
}

@keyframes pulse {
    0% { opacity: 1; }
    50% { opacity: 0.5; }
    100% { opacity: 1; }
}

.quick-actions {
    display: flex;
    gap: 8px;
    margin-top: 8px;
    justify-content: center;
}

.quick-action-btn {
    background: #f8f9fa;
    border: 1px solid #dee2e6;
    border-radius: 20px;
    padding: 8px 16px;
    font-size: 14px;
    cursor: pointer;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    gap: 6px;
}

.quick-action-btn:hover {
    background: #007bff;
    color: white;
    border-color: #007bff;
}

/* Enhanced Message Display */
.message {
    padding: 8px 12px;
    margin: 4px 0;
    border-radius: 8px;
    transition: background-color 0.2s;
}

.message:hover {
    background: rgba(0, 0, 0, 0.05);
}

.message-actions {
    opacity: 0;
    transition: opacity 0.2s;
}

.message:hover .message-actions {
    opacity: 1;
}

/* Call Enhancement Styles */
.call-controls {
    position: fixed;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(0, 0, 0, 0.8);
    padding: 12px 20px;
    border-radius: 25px;
    display: flex;
    gap: 12px;
    z-index: 1000;
}

.call-control-btn {
    background: rgba(255, 255, 255, 0.2);
    border: none;
    border-radius: 50%;
    width: 50px;
    height: 50px;
    color: white;
    cursor: pointer;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
}

.call-control-btn:hover {
    background: rgba(255, 255, 255, 0.3);
    transform: scale(1.1);
}

.call-control-btn.end-call {
    background: #dc3545;
}

.call-control-btn.end-call:hover {
    background: #c82333;
}

/* Notification animations */
@keyframes slideIn {
    from {
        transform: translateX(100%);
        opacity: 0;
    }
    to {
        transform: translateX(0);
        opacity: 1;
    }
}

/* Modal enhancements */
.modal {
    display: none;
    position: fixed;
    z-index: 1000;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.5);
    animation: fadeIn 0.3s ease;
}

.modal.show {
    display: block;
}

@keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
}

.modal-content {
    background-color: #fefefe;
    margin: 15% auto;
    padding: 20px;
    border: none;
    border-radius: 8px;
    width: 80%;
    max-width: 500px;
    animation: slideDown 0.3s ease;
}

@keyframes slideDown {
    from {
        transform: translateY(-50px);
        opacity: 0;
    }
    to {
        transform: translateY(0);
        opacity: 1;
    }
}

.close {
    color: #aaa;
    float: right;
    font-size: 28px;
    font-weight: bold;
    cursor: pointer;
}

.close:hover,
.close:focus {
    color: #000;
    text-decoration: none;
    cursor: pointer;
}


/* CommunicationX Dark Theme */
:root {
    --primary-bg: 32 34 37; /* #202225 */
    --secondary-bg: 47 49 54; /* #2f3136 */
    --tertiary-bg: 54 57 63; /* #36393f */
    --accent-bg: 64 68 75; /* #40444b */
    --text-primary: 255 255 255; /* #ffffff */
    --text-secondary: 185 187 190; /* #b9bbbe */
    --text-muted: 114 118 125; /* #72767d */
    --accent-color: 88 101 242; /* #5865f2 */
    --accent-color-hover: 71 82 196; /* #4752c4 */
    --success-color: 87 242 135; /* #57f287 */
    --warning-color: 254 231 92; /* #fee15c */
    --danger-color: 237 66 69; /* #ed4245 */
    --online-color: 87 242 135; /* #57f287 */
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background-color: rgb(var(--primary-bg));
    color: rgb(var(--text-primary));
    line-height: 1.6;
    overflow-x: hidden;
}

/* Splash Screen */
.splash-screen {
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, rgb(var(--primary-bg)), rgb(var(--secondary-bg)));
    animation: fadeIn 1s ease-in;
}

.splash-logo {
    max-width: 400px;
    width: 80%;
    height: auto;
    animation: pulse 2s infinite;
    object-fit: contain;
    border-radius: 12px;
}

@keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
}

@keyframes pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.05); }
}

/* Landing Page */
.landing-container {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, rgb(var(--primary-bg)), rgb(var(--accent-color) / 0.1));
}

.landing-content {
    text-align: center;
    max-width: 600px;
    padding: 2rem;
}

.landing-logo {
    width: 200px;
    height: auto;
    margin-bottom: 2rem;
    object-fit: contain;
    border-radius: 8px;
}

.landing-title {
    font-size: 3rem;
    font-weight: bold;
    margin-bottom: 1rem;
    background: linear-gradient(45deg, rgb(var(--accent-color)), rgb(var(--success-color)));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.landing-subtitle {
    font-size: 1.2rem;
    color: rgb(var(--text-secondary));
    margin-bottom: 2rem;
}

/* Buttons */
.btn-primary {
    background-color: rgb(var(--accent-color));
    border: none;
    color: white;
    padding: 12px 32px;
    font-size: 16px;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.2s ease;
    text-decoration: none;
    display: inline-block;
}

.btn-primary:hover {
    background-color: rgb(var(--accent-color-hover));
    transform: translateY(-1px);
}

.btn-secondary {
    background-color: rgb(var(--secondary-bg));
    border: 1px solid rgb(var(--accent-bg));
    color: rgb(var(--text-primary));
    padding: 12px 32px;
    font-size: 16px;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.2s ease;
    text-decoration: none;
    display: inline-block;
}

.btn-secondary:hover {
    background-color: rgb(var(--tertiary-bg));
}

.btn-danger {
    background-color: rgb(var(--danger-color));
    border: none;
    color: white;
    padding: 8px 16px;
    font-size: 14px;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.2s ease;
}

.btn-danger:hover {
    background-color: rgb(var(--danger-color) / 0.8);
}

/* Main Layout */
.main-container {
    display: flex;
    height: 100vh;
}

.sidebar {
    width: 280px;
    background-color: rgb(var(--secondary-bg));
    border-right: 1px solid rgb(var(--accent-bg));
    display: flex;
    flex-direction: column;
    transition: all 0.3s ease;
    position: relative;
    z-index: 100;
}

.sidebar.collapsed {
    width: 60px;
}

.sidebar.mobile-hidden {
    transform: translateX(-100%);
    position: absolute;
    height: 100vh;
    z-index: 1000;
}

.sidebar.mobile-visible {
    transform: translateX(0);
    position: absolute;
    height: 100vh;
    z-index: 1000;
    box-shadow: 2px 0 10px rgba(0, 0, 0, 0.3);
}

/* Sidebar Toggle Button */
.sidebar-toggle {
    position: absolute;
    top: 50%;
    right: -15px;
    transform: translateY(-50%);
    width: 30px;
    height: 30px;
    background-color: rgb(var(--accent-color));
    border: none;
    border-radius: 50%;
    color: white;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 101;
    transition: all 0.3s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
}

.sidebar-toggle:hover {
    background-color: rgb(var(--accent-color-hover));
    transform: translateY(-50%) scale(1.1);
}

.sidebar-toggle i {
    font-size: 12px;
    transition: transform 0.3s ease;
}

.sidebar.collapsed .sidebar-toggle i {
    transform: rotate(180deg);
}

.sidebar-header {
    padding: 1rem;
    border-bottom: 1px solid rgb(var(--accent-bg));
    display: flex;
    align-items: center;
    justify-content: space-between;
    transition: all 0.3s ease;
}

.sidebar.collapsed .sidebar-header {
    padding: 1rem 0.5rem;
    justify-content: center;
}

.sidebar.collapsed .sidebar-header > div {
    display: none;
}

.sidebar.collapsed .sidebar-header .logo-small {
    display: block;
}

.logo-small {
    width: 32px;
    height: 32px;
    object-fit: contain;
    border-radius: 4px;
}

.user-info {
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.user-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    object-fit: cover;
}

.user-name {
    font-size: 14px;
    font-weight: 600;
}

.dm-button {
    position: fixed;
    top: 1rem;
    left: 1rem;
    background-color: rgb(var(--accent-color));
    color: white;
    padding: 8px 16px;
    border: none;
    border-radius: 20px;
    cursor: pointer;
    z-index: 1000;
    font-weight: 600;
    transition: all 0.2s ease;
}

.dm-button:hover {
    background-color: rgb(var(--accent-color-hover));
    transform: scale(1.05);
}

.server-list {
    flex: 1;
    overflow-y: auto;
    padding: 1rem 0;
}

.server-item {
    padding: 0.75rem 1rem;
    margin: 0.25rem 0.5rem;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    position: relative;
}

.sidebar.collapsed .server-item {
    padding: 0.75rem 0.5rem;
    margin: 0.25rem;
    justify-content: center;
}

.sidebar.collapsed .server-name {
    display: none;
}

.sidebar.collapsed .user-item-name,
.sidebar.collapsed .dm-section h6 {
    display: none;
}

.server-item:hover {
    background-color: rgb(var(--tertiary-bg));
}

.server-item.active {
    background-color: rgb(var(--accent-color) / 0.2);
    border-left: 3px solid rgb(var(--accent-color));
}

.server-icon {
    width: 32px;
    height: 32px;
    background-color: rgb(var(--accent-color));
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    font-size: 14px;
}

.server-name {
    font-size: 14px;
    font-weight: 500;
}

/* Content Area */
.content-area {
    flex: 1;
    display: flex;
    flex-direction: column;
    background-color: rgb(var(--primary-bg));
    transition: margin-left 0.3s ease;
}

.sidebar.collapsed + .content-area {
    margin-left: 0;
}

/* Mobile Overlay */
.sidebar-overlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.5);
    z-index: 999;
}

.sidebar-overlay.active {
    display: block;
}

/* Mobile Toggle Button */
.mobile-sidebar-toggle {
    display: none;
    position: fixed;
    top: 1rem;
    left: 1rem;
    width: 40px;
    height: 40px;
    background-color: rgb(var(--accent-color));
    border: none;
    border-radius: 8px;
    color: white;
    cursor: pointer;
    z-index: 1001;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
}

.mobile-sidebar-toggle:hover {
    background-color: rgb(var(--accent-color-hover));
    transform: scale(1.05);
}

.mobile-sidebar-toggle i {
    font-size: 16px;
}

.content-header {
    padding: 1rem;
    border-bottom: 1px solid rgb(var(--accent-bg));
    background-color: rgb(var(--secondary-bg));
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.content-title {
    font-size: 18px;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.content-body {
    flex: 1;
    overflow-y: auto;
    padding: 1rem;
}

/* Messages */
.messages-container {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-height: calc(100vh - 200px);
    overflow-y: auto;
}

.message {
    display: flex;
    gap: 1rem;
    padding: 0.5rem;
    border-radius: 6px;
    transition: background-color 0.2s ease;
}

.message:hover {
    background-color: rgb(var(--secondary-bg) / 0.3);
}

.message-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: rgb(var(--accent-color));
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    font-size: 14px;
    flex-shrink: 0;
}

.message-content {
    flex: 1;
}

.message-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.25rem;
}

.message-author {
    font-weight: 600;
    font-size: 14px;
}

.message-time {
    font-size: 12px;
    color: rgb(var(--text-muted));
}

.message-text {
    font-size: 14px;
    line-height: 1.4;
}

/* Message Input */
.message-input-container {
    padding: 1rem;
    background-color: rgb(var(--secondary-bg));
    border-top: 1px solid rgb(var(--accent-bg));
}

.message-input-form {
    display: flex;
    gap: 0.5rem;
}

.message-input {
    flex: 1;
    background-color: rgb(var(--tertiary-bg));
    border: 1px solid rgb(var(--accent-bg));
    color: rgb(var(--text-primary));
    padding: 12px;
    border-radius: 6px;
    resize: none;
    outline: none;
    font-family: inherit;
}

.message-input:focus {
    border-color: rgb(var(--accent-color));
}

.message-input::placeholder {
    color: rgb(var(--text-muted));
}

/* Forms */
.form-container {
    max-width: 400px;
    margin: 2rem auto;
    padding: 2rem;
    background-color: rgb(var(--secondary-bg));
    border-radius: 8px;
    border: 1px solid rgb(var(--accent-bg));
}

.form-group {
    margin-bottom: 1rem;
}

.form-label {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: 500;
    color: rgb(var(--text-secondary));
}

.form-input {
    width: 100%;
    background-color: rgb(var(--tertiary-bg));
    border: 1px solid rgb(var(--accent-bg));
    color: rgb(var(--text-primary));
    padding: 12px;
    border-radius: 6px;
    outline: none;
    font-family: inherit;
}

.form-input:focus {
    border-color: rgb(var(--accent-color));
}

/* Modals */
.modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.5);
    z-index: 1000;
}

.modal.show {
    display: flex;
    align-items: center;
    justify-content: center;
}

.modal-content {
    background-color: rgb(var(--secondary-bg));
    border-radius: 8px;
    padding: 2rem;
    max-width: 500px;
    width: 90%;
    border: 1px solid rgb(var(--accent-bg));
}

.modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
}

.modal-title {
    font-size: 18px;
    font-weight: 600;
}

.modal-close {
    background: none;
    border: none;
    color: rgb(var(--text-muted));
    font-size: 24px;
    cursor: pointer;
}

/* Call Interface */
.call-container {
    height: 100vh;
    background-color: rgb(var(--primary-bg));
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
}

.call-video-container {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
}

.remote-video, .local-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    background-color: rgb(var(--secondary-bg));
    border-radius: 8px;
}

.local-video {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 200px;
    height: 150px;
    z-index: 10;
    border: 2px solid rgb(var(--accent-color));
}

.call-controls {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 1rem;
    background-color: rgb(var(--secondary-bg) / 0.9);
    padding: 1rem;
    border-radius: 50px;
    backdrop-filter: blur(10px);
}

.call-button {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
    font-size: 18px;
}

.call-button.mute {
    background-color: rgb(var(--warning-color));
    color: rgb(var(--primary-bg));
}

.call-button.camera {
    background-color: rgb(var(--accent-color));
    color: white;
}

.call-button.end {
    background-color: rgb(var(--danger-color));
